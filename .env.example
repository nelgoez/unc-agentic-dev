# ============================================================================
# UNC Campus Virtual — Environment Variables Template
# ============================================================================
#
# Quick Start:
# 1. Copy: cp .env.example .env   (Unix)  /  copy .env.example .env  (Windows)
# 2. Fill in your values
# 3. Never commit .env (it's in .gitignore)
#
# Load vars before launching agent:
#   bun run opencode  →  loads .env via dotenv-cli, then launches OpenCode
# ============================================================================

# ----------------------------------------------------------------------------
# MCP Server Variables
# ----------------------------------------------------------------------------

# Tavily web search (optional) — https://app.tavily.com/
TAVILY_API_KEY=

# Supabase (optional) — project reference from Supabase dashboard
SUPABASE_PROJECT_REF=

# ----------------------------------------------------------------------------
# Moodle Integration
# ----------------------------------------------------------------------------

# Moodle instance for UNC Campus Virtual
MOODLE_API_URL=https://campusvirtual.unc.edu.ar
MOODLE_API_TOKEN=

# Moodle Web Service (REST API)
MOODLE_WS_TOKEN=
TEST_COURSE_ID=269

# ----------------------------------------------------------------------------
# Guaraní Integration (future)
# ----------------------------------------------------------------------------

GUARANI_API_URL=https://guarani.unc.edu.ar
GUARANI_API_TOKEN=

# ----------------------------------------------------------------------------
# Google Cloud — APIs
# ----------------------------------------------------------------------------

# Google Sheets API key — read public spreadsheets (Fer's autotesting, validaciones)
GOOGLE_SHEETS_API_KEY=

# ----------------------------------------------------------------------------
# Automation Trigger (QA Audit re-run)
# ----------------------------------------------------------------------------

# Google Apps Script web app /exec URL that triggers the audit-ci workflow.
# Public URL (not a secret). Copy from: script.google.com → Deploy → Web app.
AUDIT_TRIGGER_URL=

# ----------------------------------------------------------------------------
# Development
# ----------------------------------------------------------------------------

NODE_ENV=development

# ----------------------------------------------------------------------------
# Testing credentials (campus.aulavirtual.unc.edu.ar)
# ----------------------------------------------------------------------------

STUDENT_USERNAME=
STUDENT_PASSWORD=

ADMIN_USERNAME=
ADMIN_PASSWORD=
MOODLE_BASE_URL=https://campus.aulavirtual.unc.edu.ar

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# - Supabase MCP uses OAuth — no access token needed for MCP itself.
#   Project ref is configured in opencode.jsonc mcp.supabase.url.
# - Variables are loaded at agent start via dotenv-cli.
# - MCP servers inherit the process environment.
# - Keep this file updated when adding new variables.
# ============================================================================
